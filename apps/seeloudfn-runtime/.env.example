R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="seeloud"

REDIS_HOST="localhost"
REDIS_PORT="6379"

# Directory where worker.mjs files and capnp configs are cached on disk
SEELOUDFN_CACHE_DIR="/tmp/seeloudfn"

# Optional tuning
# SEELOUDFN_POOL_MAX=20
# SEELOUDFN_IDLE_TTL_MS=300000
# WORKERD_BIN=/path/to/workerd
