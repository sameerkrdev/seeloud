DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seeloud"

# Must match apps/api/.env and apps/seeloud-actions/.env
ENV_ENCRYPTION_KEY="your-64-char-hex-key-here"

# Must match apps/seeloud-actions/.env WORKER_SECRET
WORKER_SECRET="change-this-to-a-long-random-secret"

REDIS_HOST="localhost"
REDIS_PORT="6379"

# Internal URL of the api service (for posting logs and status updates)
SEELOUD_ACTIONS_INTERNAL_URL="http://localhost:3001"

# How many jobs to process in parallel (each job = one Docker container)
WORKER_CONCURRENCY="2"
